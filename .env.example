# Copy to .env and fill in with YOUR OWN dev tenant.
# Never commit the filled file. Never use a production tenant.

# Tenant identifier: use the tenant domain or GUID, never a real production one.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Public client (PKCE, no secret) is preferred for harness work.
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Only for confidential-client tests. Leave blank for public-client flows.
ENTRA_CLIENT_SECRET=

# Redirect URI registered on the app (loopback for device/desktop harnesses)
ENTRA_REDIRECT_URI=http://localhost:8400/callback

# Scopes for the harness; keep minimal
ENTRA_SCOPES=openid profile offline_access
